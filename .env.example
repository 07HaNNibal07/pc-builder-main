# Select one provider. The API is deliberately unavailable until its required setting is supplied.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local alternative. Do not install or download Ollama models in the API container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

AI_TEMPERATURE=0
AI_TIMEOUT_SECONDS=60

# Optional future RAG extension; it is not required for /api/ai/chat.
QDRANT_URL=
QDRANT_COLLECTION=
