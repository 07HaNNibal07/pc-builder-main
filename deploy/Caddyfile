# Caddy перед pcb-api: HTTPS на домене (сертификат Let's Encrypt получает и продлевает сам),
# www → основной домен, по голому IP сайт по-прежнему открывается по http.
# Журнал посещений — /data/logs/access.log (том caddy_data), смотреть scripts/visits.sh.
(visits) {
	log {
		output file /data/logs/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 2160h
		}
	}
}

pcpodbor.ru {
	import visits
	reverse_proxy api:8000
}

# www и старый домен (до 18.09.2026) → основной
www.pcpodbor.ru, albion-x.shop, www.albion-x.shop {
	redir https://pcpodbor.ru{uri} permanent
}

:80 {
	import visits
	reverse_proxy api:8000
}
